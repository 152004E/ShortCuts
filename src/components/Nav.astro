---
const base = import.meta.env.BASE_URL;

const links = [
  { href: `${base}`, label: "Atajos", page: "atajos" },
  { href: `${base}open-code/`, label: "Script Meta+C (VS Code)", page: "open-code" },
  { href: `${base}guia-gnome/`, label: "Ubuntu/GNOME", page: "guia-gnome" },
  { href: `${base}barras-pantallas/`, label: "Barras 2 pantallas", page: "barras-pantallas" },
];

interface Props {
  page: string;
}

const { page: current } = Astro.props;
---

<nav class="mb-8 flex flex-wrap justify-center gap-2.5">
  {links.map((l) => (
    <a
      href={l.href}
      class:list={[
        "rounded-full border border-border bg-card px-4 py-2 text-sm text-text transition-colors",
        current === l.page ? "border-accent bg-card-2" : "hover:border-accent hover:bg-card-2",
      ]}
    >
      {l.label}
    </a>
  ))}
</nav>