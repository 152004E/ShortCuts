---
const children = await Astro.slots.render("default");
const parts = children.split("+").map((p) => p.trim()).filter(Boolean);
const isRange = children.includes("–") || children.includes("-");
---

{!isRange && parts.length > 1 && (
  <span class="whitespace-nowrap">
    {parts.map((p, i) => (
      <span>
        {i > 0 && "+ "}
        <kbd class="kbd">{p}</kbd>
      </span>
    ))}
  </span>
)}
{isRange && <kbd class="kbd">{children}</kbd>}