---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Props {
  title: string;
  subtitle?: string;
  page: "atajos" | "open-editor" | "guia-gnome" | "barras-pantallas";
  showSearch?: boolean;
  prose?: boolean;
}

const { title, subtitle, page, showSearch = false, prose = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/ShortCuts/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <div class="mx-auto max-w-240 px-4 pb-20">
      <header class="mb-9 text-center">
        <h1 class="mb-1.5 bg-linear-to-r from-accent to-accent-2 bg-clip-text text-[2.4rem] font-bold leading-tight text-transparent">
          {title}
        </h1>
        {subtitle && <p class="text-muted">{subtitle}</p>}
      </header>

      <Nav page={page} />

      {showSearch && (
        <div class="relative mx-auto mb-10 max-w-130">
          <span class="pointer-events-none absolute left-4.5 top-1/2 -translate-y-1/2 text-muted">🔍</span>
          <input
            id="buscar"
            type="text"
            placeholder="Buscar atajo (ej: ventana, terminal, copiar...)"
            autocomplete="off"
            class="w-full rounded-full border border-border bg-card py-3.5 pl-12 pr-5 text-text outline-none transition-colors focus:border-accent focus:ring-2 focus:ring-accent/20"
          />
        </div>
      )}

      <div class:list={["prose", prose && "prose-md"]}>
        <slot />
      </div>

      <footer class="mt-5 text-center text-sm text-muted">
        Hecho con ❤️ en Arch Linux · KDE Plasma 6 · Astro + Tailwind
      </footer>
    </div>
  </body>
</html>